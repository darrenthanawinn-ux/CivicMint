# Copy this file to .env and fill in what you have. CivicMint runs in a
# fully functional degraded mode (rule-based, citation-backed results) with
# NO keys configured at all -- these are optional but unlock full LLM
# reasoning.

ENVIRONMENT=development
DEBUG=true

# Provide EITHER of these to enable full LLM-powered analysis.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# CORS: comma-separated list is NOT supported by pydantic-settings' default
# List parsing from env vars; set via a JSON array string if overriding, e.g.
# ALLOWED_ORIGINS=["http://localhost:3000"]
